{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LineCounter",
  "version": "1.0.0",
  "identifier": "com.linecounter.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LineCounter",
        "width": 1140,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#070a12",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
